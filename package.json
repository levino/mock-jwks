{
  "name": "mock-jwks",
  "description": "A tool to mock a JWKS for development of microservices who consume jwts signed with RSA",
  "version": "4.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown --config-loader native",
    "test": "vitest",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "postpack": "npm run clean",
    "lint": "biome check",
    "format": "biome check --write",
    "check:code": "tsc && tsc -p tsconfig.examples.json"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "contributors": [
    {
      "email": "post@levinkeller.de",
      "name": "Levin Keller",
      "url": "https://github.com/Levino"
    },
    {
      "name": "Andrew Schekatihin",
      "url": "https://github.com/aschekatihin"
    },
    {
      "name": "Marek Urbanowicz",
      "url": "https://github.com/murbanowicz"
    },
    {
      "name": "Martin Levett",
      "url": "https://github.com/mlev"
    }
  ],
  "repository": {
    "url": "https://github.com/levino/mock-jwks"
  },
  "keywords": [
    "jwks",
    "jwt",
    "mock",
    "testing"
  ],
  "author": "Levin Keller",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Levino/mock-jwks/issues"
  },
  "homepage": "https://github.com/Levino/mock-jwks#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "jwks-rsa": "^4.1.0",
    "supertest": "^7.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "jsonwebtoken": "^9.0.3",
    "msw": "^2.15.0",
    "node-forge": "^1.4.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
